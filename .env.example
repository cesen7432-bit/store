# ════════════════════════════════════════════════════════════════
#  CECOM Store — copia este archivo como .env (uno solo para todo)
# ════════════════════════════════════════════════════════════════

# ─── Frontend (Vite) ───
# false = backend real (server/); true = modo demo sin backend (datos en el navegador)
VITE_USE_MOCK=false
# VITE_SEASON=auto

# ─── Backend ───
PORT=4000
# Mínimo 32 caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
MAX_UPLOAD_MB=5
# Videos de proyectos y adjuntos de cotizaciones (MB)
MAX_VIDEO_MB=60
MAX_QUOTE_FILE_MB=20
# Solo si el frontend se sirve desde otro dominio (separados por coma)
# CORS_ORIGIN=
# Rutas en desarrollo (en Docker se usan volúmenes)
# DB_FILE=data/cecom.db
# UPLOADS_DIR=uploads

# Administrador inicial (se crea solo si no existe ningún admin)
ADMIN_EMAIL=steven.r.cesen@hotmail.com
ADMIN_NAME=Steven Cesen
ADMIN_PHONE=
# Vacío en producción → se genera una y se muestra UNA vez en: docker compose logs api
ADMIN_PASSWORD=

# 2FA: sms | console | whatsapp | twilio  (console = el código sale en la consola, solo desarrollo)
OTP_PROVIDER=sms
SMS_BASE_URL=https://apps-cecom.cloud/gw-sms
SMS_APP_ID=
SMS_APP_SECRET=
# WhatsApp Cloud API (opcional)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=codigo_verificacion
# Twilio (opcional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ─── Docker Compose ───
# Puerto local (127.0.0.1) del contenedor web; Apache reenvía https://apps-cecom.cloud/store/ aquí
PUBLIC_PORT=8850
# Proxies delante del backend: 2 = Apache del servidor + Nginx del contenedor
TRUST_PROXY=2
